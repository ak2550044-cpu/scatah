<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scatch | Shop</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#f8f7f4] text-stone-900">
  <% const products = typeof product !== 'undefined' && Array.isArray(product) ? product : []; %>
  <%- include('header') %>

  <main class="mx-auto max-w-7xl px-5 py-8 sm:px-6 sm:py-12">
    <% if (typeof success !== 'undefined' && success.length) { %>
      <div role="status" class="mb-6 flex items-center gap-3 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800">
        <span class="flex h-6 w-6 items-center justify-center rounded-full bg-green-600 text-white">✓</span><%= success[0] %>
      </div>
    <% } %>
    <% if (typeof error !== 'undefined' && error.length) { %>
      <div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error[0] %></div>
    <% } %>

    <section class="relative mb-12 overflow-hidden rounded-3xl bg-stone-900 px-7 py-10 text-white sm:px-12 sm:py-14">
      <div class="absolute -right-16 -top-20 h-64 w-64 rounded-full bg-orange-500/20 blur-3xl"></div>
      <div class="relative max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.28em] text-orange-400">Curated essentials</p>
        <h1 class="mt-4 text-4xl font-black tracking-tight sm:text-5xl">Carry more. Worry less.</h1>
        <p class="mt-4 max-w-lg text-base leading-7 text-stone-300">Functional bags designed to keep up with every commute, escape, and everyday plan.</p>
      </div>
    </section>

    <div class="mb-7 flex items-end justify-between gap-4 border-b border-stone-200 pb-5">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-600">The collection</p>
        <h2 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">Made for your day.</h2>
      </div>
      <p class="rounded-full bg-white px-3 py-1.5 text-sm font-medium text-stone-600 ring-1 ring-stone-200"><%= products.length %> item<%= products.length === 1 ? '' : 's' %></p>
    </div>

    <% if (products.length === 0) { %>
      <section class="rounded-3xl border-2 border-dashed border-stone-300 bg-white px-6 py-20 text-center">
        <div class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-orange-50 text-2xl">👜</div>
        <h2 class="mt-5 text-xl font-bold">No products available yet.</h2>
        <p class="mt-2 text-stone-500">Fresh arrivals will appear here soon.</p>
      </section>
    <% } else { %>
      <section class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
        <% products.forEach(function(item) { %>
          <% const discount = Math.min(100, Math.max(0, Number(item.discount) || 0)); %>
          <% const price = Number(item.price) || 0; %>
          <% const salePrice = Math.max(0, price - (price * discount / 100)); %>
          <article class="group flex overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5 transition duration-300 hover:-translate-y-1 hover:shadow-xl" style="background-color: <%= item.panelcolor || '#ffffff' %>; color: <%= item.textcolor || '#1c1917' %>">
            <div class="flex w-full flex-col">
            <div class="relative aspect-[4/3] overflow-hidden" style="background-color: <%= item.bgcolor || '#e7e5e4' %>">
              <% if (item.image) { %>
                <img src="<%= item.image %>" alt="<%= item.name || 'Product image' %>" class="h-full w-full object-cover transition duration-500 group-hover:scale-105">
              <% } else { %>
                <div class="flex h-full items-center justify-center text-sm opacity-60">No image available</div>
              <% } %>
              <% if (discount > 0) { %>
                <span class="absolute left-3 top-3 rounded-full bg-orange-600 px-3 py-1 text-xs font-bold text-white shadow-sm"><%= discount %>% OFF</span>
              <% } %>
            </div>
            <div class="flex flex-1 flex-col p-5">
              <p class="text-[11px] font-bold uppercase tracking-[0.18em] opacity-50">Scatch carry</p>
              <h2 class="mt-1 truncate text-lg font-bold"><%= item.name || 'Untitled product' %></h2>
              <div class="mt-3 flex items-center gap-2">
                <span class="text-xl font-black">&#8377;<%= salePrice.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span>
                <% if (discount > 0) { %>
                  <span class="text-sm line-through opacity-55">&#8377;<%= price.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span>
                <% } %>
              </div>
              <form action="/addtocart/<%= item._id %>" method="POST" class="mt-5">
                <button type="submit" class="w-full rounded-xl bg-stone-900 px-4 py-3 text-sm font-bold text-white transition hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2">Add to bag <span aria-hidden="true">→</span></button>
              </form>
            </div>
            </div>
          </article>
        <% }); %>
      </section>
    <% } %>
  </main>
</body>
</html>
