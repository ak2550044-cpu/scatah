<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scatch | Welcome</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-stone-100 text-stone-900">
  <%- include('header') %>
  <main class="mx-auto flex min-h-screen max-w-6xl items-center px-6 py-10">
    <section class="grid w-full overflow-hidden rounded-3xl bg-white shadow-xl shadow-stone-300/50 lg:grid-cols-2">
      <div class="flex min-h-[310px] flex-col justify-between bg-stone-900 p-8 text-white sm:p-12">
        <a href="/" class="text-3xl font-black tracking-tight">SCATCH<span class="text-orange-500">.</span></a>
        <div class="my-16">
          <p class="text-sm font-semibold uppercase tracking-[0.25em] text-orange-400">Made to move</p>
          <h1 class="mt-4 max-w-md text-4xl font-bold leading-tight sm:text-5xl">Carry the day your way.</h1>
          <p class="mt-5 max-w-sm text-stone-300">Discover bags designed for every plan, every place, and every day.</p>
        </div>
        <p class="text-sm text-stone-400">Your next essential is waiting.</p>
      </div>

      <div class="p-8 sm:p-12">
        <% if (typeof error !== 'undefined' && error.length) { %>
          <div class="mb-6 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"><%= error[0] %></div>
        <% } %>

        <div class="grid gap-10">
          <section>
            <div class="mb-6">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">New here?</p>
              <h2 class="mt-1 text-2xl font-bold">Create an account</h2>
            </div>
            <form action="/users/register" method="POST" class="space-y-4">
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Full name</span>
                <input type="text" name="fullname" autocomplete="name" placeholder="Your name" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-100">
              </label>
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Email address</span>
                <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-100">
              </label>
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Password</span>
                <input type="password" name="password" autocomplete="new-password" placeholder="Create a password" required minlength="6" class="w-full rounded-lg border border-stone-300 px-3 py-2.5 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-100">
              </label>
              <button type="submit" class="w-full rounded-lg bg-stone-900 px-4 py-3 font-semibold text-white transition hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2">Create account</button>
            </form>
          </section>

          <section class="border-t border-stone-200 pt-8">
            <div class="mb-6">
              <p class="text-sm font-semibold uppercase tracking-[0.18em] text-orange-600">Welcome back</p>
              <h2 class="mt-1 text-2xl font-bold">Log in</h2>
            </div>
            <form action="/users/login" method="POST" class="grid gap-4 sm:grid-cols-[1fr_1fr_auto] sm:items-end">
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Email address</span>
                <input type="email" name="email" autocomplete="email" placeholder="you@example.com" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-100">
              </label>
              <label class="block">
                <span class="mb-1.5 block text-sm font-medium">Password</span>
                <input type="password" name="password" autocomplete="current-password" placeholder="Your password" required class="w-full rounded-lg border border-stone-300 px-3 py-2.5 outline-none transition focus:border-orange-500 focus:ring-2 focus:ring-orange-100">
              </label>
              <button type="submit" class="rounded-lg border border-stone-900 px-5 py-2.5 font-semibold transition hover:bg-stone-900 hover:text-white focus:outline-none focus:ring-2 focus:ring-stone-500 focus:ring-offset-2">Log in</button>
            </form>
          </section>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
