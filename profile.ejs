<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Scatch | My Account</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { font-family: 'DM Sans', sans-serif; }
        .heading-font { font-family: 'Space Grotesk', sans-serif; }
        
        .glass-card {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }

        @keyframes slideIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .animate-in { animation: slideIn 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards; }
    </style>
</head>
<body class="min-h-screen bg-[#fafaf9] text-stone-900">
    <!-- Subtle Background Elements -->
    <div class="fixed inset-0 -z-10 overflow-hidden">
        <div class="absolute -top-[10%] -left-[10%] h-[40%] w-[40%] rounded-full bg-orange-100/50 blur-[120px]"></div>
        <div class="absolute bottom-[10%] right-[5%] h-[30%] w-[30%] rounded-full bg-stone-200/50 blur-[100px]"></div>
    </div>

    <% const account = typeof user !== 'undefined' && user ? user : {}; %>
    <% const cartCount = Array.isArray(account.cart) ? account.cart.length : 0; %>
    <% const orderCount = Array.isArray(account.orders) ? account.orders.length : 0; %>
    
    <%- include('header', { loggedin: true }) %>

    <main class="mx-auto max-w-6xl px-6 py-12 lg:py-16 animate-in">
        <!-- Header Section -->
        <header class="mb-12 flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
            <div>
                <nav class="mb-4 flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-orange-600">
                    <span>Account</span>
                    <span class="text-stone-300">/</span>
                    <span class="text-stone-400">Dashboard</span>
                </nav>
                <h1 class="heading-font text-4xl font-bold tracking-tight text-stone-900 sm:text-5xl">
                    Welcome back, <span class="text-orange-600"><%= account.fullname?.split(' ')[0] || 'Member' %></span>
                </h1>
            </div>
            <div class="flex gap-3">
                <a href="/shop" class="group flex items-center gap-2 rounded-full border border-stone-200 bg-white px-6 py-3 text-sm font-bold transition-all hover:bg-stone-50 hover:shadow-md">
                    Continue Shopping
                    <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </a>
            </div>
        </header>

        <div class="grid grid-cols-1 gap-8 lg:grid-cols-12">
            
            <!-- Left Column: Profile Card -->
            <div class="lg:col-span-8">
                <section class="overflow-hidden rounded-[2rem] border border-stone-200 bg-white shadow-xl shadow-stone-200/40">
                    <!-- Profile Hero -->
                    <div class="relative bg-stone-900 p-8 text-white sm:p-12">
                        <div class="absolute top-0 right-0 p-4">
                            <button class="rounded-full bg-white/10 p-2 text-white/80 transition-colors hover:bg-white/20">
                                <svg class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                            </button>
                        </div>
                        
                        <div class="flex flex-col items-center gap-6 sm:flex-row">
                            <div class="relative">
                                <% if (account.picture) { %>
                                    <img src="<%= account.picture %>" class="h-28 w-28 rounded-3xl object-cover ring-4 ring-orange-500/30" alt="Profile">
                                <% } else { %>
                                    <div class="heading-font flex h-28 w-28 items-center justify-center rounded-3xl bg-gradient-to-br from-orange-400 to-orange-600 text-4xl font-bold">
                                        <%= (account.fullname || 'S').charAt(0).toUpperCase() %>
                                    </div>
                                <% } %>
                                <div class="absolute -bottom-2 -right-2 rounded-full bg-green-500 p-1.5 ring-4 ring-stone-900">
                                    <div class="h-2 w-2 rounded-full bg-white animate-pulse"></div>
                                </div>
                            </div>
                            
                            <div class="text-center sm:text-left">
                                <span class="mb-2 inline-block rounded-full bg-orange-500/20 px-3 py-1 text-[10px] font-bold uppercase tracking-widest text-orange-400 ring-1 ring-orange-500/30">
                                    <%= account.isadmin ? 'Staff Member' : 'Preferred Customer' %>
                                </span>
                                <h2 class="heading-font text-3xl font-bold"><%= account.fullname || 'Scatch Member' %></h2>
                                <p class="text-stone-400"><%= account.email %></p>
                            </div>
                        </div>
                    </div>

                    <!-- Details Grid -->
                    <div class="grid gap-px bg-stone-100 p-px sm:grid-cols-2">
                        <div class="bg-white p-8 transition-colors hover:bg-stone-50">
                            <p class="text-xs font-bold uppercase tracking-widest text-stone-400">Primary Email</p>
                            <p class="mt-2 font-medium text-stone-900"><%= account.email || '—' %></p>
                        </div>
                        <div class="bg-white p-8 transition-colors hover:bg-stone-50">
                            <p class="text-xs font-bold uppercase tracking-widest text-stone-400">Phone Number</p>
                            <p class="mt-2 font-medium text-stone-900"><%= account.contact || 'Not provided' %></p>
                        </div>
                        <div class="bg-white p-8 transition-colors hover:bg-stone-50">
                            <p class="text-xs font-bold uppercase tracking-widest text-stone-400">Member Since</p>
                            <p class="mt-2 font-medium text-stone-900">August 2024</p> <!-- Mock date -->
                        </div>
                        <div class="bg-white p-8 transition-colors hover:bg-stone-50">
                            <p class="text-xs font-bold uppercase tracking-widest text-stone-400">Shipping Region</p>
                            <p class="mt-2 font-medium text-stone-900">India</p> <!-- Mock data -->
                        </div>
                    </div>
                </section>
            </div>

            <!-- Right Column: Stats & Actions -->
            <div class="space-y-6 lg:col-span-4">
                <!-- Cart Card -->
                <a href="/cart" class="group block overflow-hidden rounded-[2rem] bg-orange-600 p-8 text-white transition-all hover:scale-[1.02] hover:shadow-2xl hover:shadow-orange-200">
                    <div class="flex justify-between">
                        <div class="rounded-2xl bg-white/20 p-3">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
                        </div>
                        <svg class="h-5 w-5 text-white/50 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </div>
                    <div class="mt-8">
                        <p class="heading-font text-5xl font-bold"><%= cartCount %></p>
                        <p class="mt-2 font-medium text-orange-100">Items in your cart</p>
                    </div>
                </a>

                <!-- Orders Card -->
                <div class="rounded-[2rem] border border-stone-200 bg-white p-8 shadow-sm transition-all hover:shadow-md">
                    <div class="flex items-center gap-4">
                        <div class="rounded-2xl bg-stone-100 p-3 text-stone-600">
                            <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                        </div>
                        <div>
                            <p class="heading-font text-2xl font-bold"><%= orderCount %></p>
                            <p class="text-sm font-medium text-stone-500">Total Orders</p>
                        </div>
                    </div>
                    <div class="mt-6 border-t border-stone-100 pt-6">
                        <p class="text-xs leading-relaxed text-stone-400">
                            You've placed <span class="font-bold text-stone-600"><%= orderCount %></span> orders since joining. 
                            <a href="/orders" class="text-orange-600 underline underline-offset-4 hover:text-orange-700">Track history</a>
                        </p>
                    </div>
                </div>

                <!-- Danger Zone / Logout -->
                <div class="rounded-3xl border border-stone-100 bg-stone-50 p-6">
                    <a href= "/logout" class="flex w-full items-center justify-center gap-2 rounded-2xl border border-stone-200 bg-white py-3 text-sm font-bold text-red-600 transition-colors hover:bg-red-50">
                        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                        Sign out
                    </a>
                </div>
            </div>
        </div>
    </main>
</body>
</html>