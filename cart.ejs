<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Scatch | Your Cart</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="min-h-screen bg-[#f8f7f4] text-stone-900">
  <% const cartItems = typeof cart !== 'undefined' && Array.isArray(cart) ? cart.filter(Boolean) : []; %>
  <% const subtotal = cartItems.reduce((total, item) => { const price = Number(item.price) || 0; const discount = Math.min(100, Math.max(0, Number(item.discount) || 0)); return total + Math.max(0, price - (price * discount / 100)); }, 0); %>
  <%- include('header') %>

  <main class="mx-auto max-w-7xl px-5 py-8 sm:px-6 sm:py-12">
    <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.24em] text-orange-600">Your selection</p>
        <h1 class="mt-2 text-3xl font-black tracking-tight sm:text-4xl">Shopping cart</h1>
        <p class="mt-2 text-stone-600"><%= cartItems.length %> item<%= cartItems.length === 1 ? '' : 's' %> ready to go with you.</p>
      </div>
      <a href="/shop" class="inline-flex w-fit items-center gap-2 rounded-xl border border-stone-300 bg-white px-4 py-2.5 text-sm font-bold transition hover:border-stone-900 hover:bg-stone-900 hover:text-white">Continue shopping <span aria-hidden="true">&rarr;</span></a>
    </div>

    <% if (typeof success !== 'undefined' && success.length) { %><div role="status" class="mb-6 rounded-xl border border-green-200 bg-green-50 px-4 py-3 text-sm font-medium text-green-800"><%= success[0] %></div><% } %>
    <% if (typeof error !== 'undefined' && error.length) { %><div role="alert" class="mb-6 rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm font-medium text-red-700"><%= error[0] %></div><% } %>

    <% if (cartItems.length === 0) { %>
      <section class="rounded-3xl border-2 border-dashed border-stone-300 bg-white px-6 py-20 text-center">
        <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-orange-50 text-3xl" aria-hidden="true">&#128717;</div>
        <h2 class="mt-5 text-2xl font-bold">Your cart is empty.</h2>
        <p class="mt-2 text-stone-500">Find a bag that is ready for wherever you are headed.</p>
        <a href="/shop" class="mt-7 inline-flex rounded-xl bg-stone-900 px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-600">Browse the collection</a>
      </section>
    <% } else { %>
      <div class="grid gap-7 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
        <section class="overflow-hidden rounded-3xl bg-white shadow-sm ring-1 ring-stone-200">
          <div class="border-b border-stone-100 px-5 py-4 sm:px-6"><h2 class="font-bold">Items in your cart</h2></div>
          <div class="divide-y divide-stone-100">
            <% cartItems.forEach(function(item) { %>
              <% const price = Number(item.price) || 0; const discount = Math.min(100, Math.max(0, Number(item.discount) || 0)); const salePrice = Math.max(0, price - (price * discount / 100)); %>
              <article class="flex gap-4 p-5 sm:gap-6 sm:p-6">
                <div class="h-24 w-24 shrink-0 overflow-hidden rounded-2xl sm:h-28 sm:w-28" style="background-color: <%= item.bgcolor || '#e7e5e4' %>">
                  <% if (item.image) { %><img src="<%= item.image %>" alt="<%= item.name || 'Product image' %>" class="h-full w-full object-cover"><% } else { %><div class="flex h-full items-center justify-center text-xs text-stone-500">No image</div><% } %>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-stone-400">Scatch carry</p>
                  <h3 class="mt-1 truncate text-lg font-bold"><%= item.name || 'Untitled product' %></h3>
                  <% if (discount > 0) { %><p class="mt-1 text-xs font-bold text-orange-600"><%= discount %>% off applied</p><% } %>
                  <div class="mt-3 flex items-center justify-between gap-3">
                    <p class="text-lg font-black">&#8377;<%= salePrice.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %> <% if (discount > 0) { %><span class="ml-1 text-sm font-medium text-stone-400 line-through">&#8377;<%= price.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span><% } %></p>
                    <form action="/removefromcart/<%= item._id %>" method="POST"><button type="submit" class="text-sm font-bold text-stone-500 transition hover:text-red-600">Remove</button></form>
                  </div>
                </div>
              </article>
            <% }); %>
          </div>
        </section>

        <aside class="rounded-3xl bg-stone-900 p-6 text-white shadow-lg shadow-stone-300/60 lg:sticky lg:top-6">
          <p class="text-xs font-bold uppercase tracking-[0.2em] text-orange-400">Order summary</p>
          <div class="mt-6 space-y-4 border-b border-white/15 pb-5 text-sm text-stone-300">
            <div class="flex justify-between"><span>Subtotal</span><span>&#8377;<%= subtotal.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span></div>
            <div class="flex justify-between"><span>Delivery</span><span class="font-bold text-orange-400">Free</span></div>
          </div>
          <div class="mt-5 flex items-end justify-between"><span class="font-bold">Total</span><span class="text-2xl font-black">&#8377;<%= subtotal.toLocaleString('en-IN', { maximumFractionDigits: 2 }) %></span></div>
          <button type="button" class="mt-7 w-full rounded-xl bg-orange-500 px-4 py-3.5 text-sm font-bold text-white transition hover:bg-orange-400 focus:outline-none focus:ring-2 focus:ring-orange-300 focus:ring-offset-2 focus:ring-offset-stone-900">Proceed to checkout</button>
          <p class="mt-4 text-center text-xs leading-5 text-stone-400">Secure checkout and free delivery on every order.</p>
        </aside>
      </div>
    <% } %>
  </main>
</body>
</html>
